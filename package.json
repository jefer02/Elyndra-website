{
  "name": "elyndra-website",
  "version": "1.0.0",
  "private": true,
  "description": "Showcase and download site for Elyndra, the console-style game launcher for Android.",
  "license": "UNLICENSED",
  "author": "Jeferson Manuel Morillo Vallejo (https://github.com/jefer02)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "snapshot": "node scripts/snapshot-releases.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/snapshot-releases.mjs && npm run typecheck && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/optimize-assets.mjs",
    "masha": "node scripts/build-masha.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "wrangler dev",
    "video": "node scripts/encode-videos.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
